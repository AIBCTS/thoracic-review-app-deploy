	journal = {CLINICAL TRANSPLANTATION},
	keywords = {REASON_eligible, SCREEN_ACCEPT},
	number = {8},
	title = {Machine Learning for 1-Year Graft Failure Prediction in Lung Transplant Recipients: The Korean Organ Transplantation Registry},
	volume = {39},
	year = {2025}
}

