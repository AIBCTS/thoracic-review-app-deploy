}

@article{zhou_prediction_2021,
	title = {Prediction of 1-year mortality after heart transplantation using machine learning approaches: {A} single-center study from {China}},
	volume = {339},
	issn = {1874-1754 (Electronic) 0167-5273 (Linking)},
	doi = {10.1016/j.ijcard.2021.07.024},
	abstract = {BACKGROUND: Heart transplantation (HTx) remains the gold-standard treatment for end-stage heart failure. The aim of this study was to establish a risk-prediction model for assessing prognosis of HTx using machine-learning approach. METHODS: Consecutive recipients of orthotopic HTx at our institute between January 1st, 2015 and December 31st, 2018 were included in this study. The primary outcome was 1-year mortality. Least absolute shrinkage and selection operator method was used to select variables and seven different machine-learning approaches were employed to develop the risk-prediction model. Bootstrap method was used for model validation. Shapley Additive exPlanations (SHAP) method was used for model interpretation. RESULTS: 381 recipients were included with average age of 43.783 years old. Albumin, recipient age and left atrium diameter ranked top three most important variables that affected the 1-year mortality of HTx. Other important variables included red blood cell, hemoglobin, lymphocyte\%, smoking history, use of lyophilized rhBNP, use of Levosimendan, hypertension, cardiac surgery history, malignancy and endotracheal intubation history. Random Forest (RF) model achieved the best area under curves (AUC) of 0.801 and gradient boosting machine (GBM) showed the best sensitivity of 0.271. SHAP method was introduced to display the RF model's predicting processes of "survival" or "death" in individual level. CONCLUSIONS: We established the risk-prediction model for postoperative prognosis of HTx patients by using machine learning method and demonstrated that the RF model performed the highest discrimination with the largest AUC when validated. This prediction model could help to recognize high-risk HTx recipients, provide personalized therapy plan and reduce organ wastage.},
	journal = {Int J Cardiol},
	author = {Zhou, Y. and Chen, S. and Rao, Z. and Yang, D. and Liu, X. and Dong, N. and Li, F.},
	month = sep,
	year = {2021},
	keywords = {*Cardiac Surgical Procedures, *Heart Failure, *Heart Transplantation, Adult, China/epidemiology, Heart transplantation, Humans, Machine Learning, Machine-learning approach, Risk-prediction model, Shapley Additive exPlanations},
	pages = {21--27},
	annote = {The following values have no corresponding Zotero field:auth-address: Department of Cardiovascular Surgery, Union Hospital, Tongji Medical College, Huazhong University of Science and Technology, Wuhan, China. Department of Data Science, Guangzhou AID Cloud Technology, Guangzhou, Guangdong, China. Department of Cardiovascular Surgery, Union Hospital, Tongji Medical College, Huazhong University of Science and Technology, Wuhan, China. Electronic address: lifei\_union@sina.com.edition: 20210713accession-num: 34271025remote-database-provider: NLM},
	annote = {Zhou, YingChen, SiRao, ZhenqiYang, DongLiu, XiangDong, NianguoLi, FeiengNetherlands2021/07/17Int J Cardiol. 2021 Sep 15;339:21-27. doi: 10.1016/j.ijcard.2021.07.024. Epub 2021 Jul 13.},
	file = {57_Zhou-2021-Prediction of 1-year mortality after.pdf}
}

@article{barbosa_machine_2018,
	title = {Machine {Learning} {Algorithms} {Utilizing} {Quantitative} {CT} {Features} {May} {Predict} {Eventual} {Onset} of {Bronchiolitis} {Obliterans} {Syndrome} {After} {Lung} {Transplantation}},
	volume = {25},
	issn = {1878-4046 (Electronic) 1076-6332 (Linking)},
	doi = {10.1016/j.acra.2018.01.013},
	abstract = {RATIONALE AND OBJECTIVES: Long-term survival after lung transplantation (LTx) is limited by bronchiolitis obliterans syndrome (BOS), defined as a sustained decline in forced expiratory volume in the first second (FEV(1)) not explained by other causes. We assessed whether machine learning (ML) utilizing quantitative computed tomography (qCT) metrics can predict eventual development of BOS. MATERIALS AND METHODS: Paired inspiratory-expiratory CT scans of 71 patients who underwent LTx were analyzed retrospectively (BOS [n = 41] versus non-BOS [n = 30]), using at least two different time points. The BOS cohort experienced a reduction in FEV(1) of {\textgreater}10\% compared to baseline FEV(1) post LTx. Multifactor analysis correlated declining FEV(1) with qCT features linked to acute inflammation or BOS onset. Student t test and ML were applied on baseline qCT features to identify lung transplant patients at baseline that eventually developed BOS. RESULTS: The FEV(1) decline in the BOS cohort correlated with an increase in the lung volume (P = .027) and in the central airway volume at functional residual capacity (P = .018), not observed in non-BOS patients, whereas the non-BOS cohort experienced a decrease in the central airway volume at total lung capacity with declining FEV(1) (P = .039). Twenty-three baseline qCT parameters could significantly distinguish between non-BOS patients and eventual BOS developers (P {\textless} .05), whereas no pulmonary function testing parameters could. Using ML methods (support vector machine), we could identify BOS developers at baseline with an accuracy of 85\%, using only three qCT parameters. CONCLUSIONS: ML utilizing qCT could discern distinct mechanisms driving FEV(1) decline in BOS and non-BOS LTx patients and predict eventual onset of BOS. This approach may become useful to optimize management of LTx patients.},
	number = {9},
	journal = {Acad Radiol},
	author = {Barbosa, E. J. M. and Lanclus, M. and Vos, W. and Van Holsbeke, C. and De Backer, W. and De Backer, J. and Lee, J.},
	month = sep,
	year = {2018},
	keywords = {*Machine Learning, *Tomography, X-Ray Computed/methods, Adult, Aged, bronchiolitis obliterans syndrome, Bronchiolitis Obliterans/*etiology/*physiopathology, computer-assisted image processing, Female, Forced Expiratory Volume, Humans, lung transplant rejection, Lung transplantation, Lung Transplantation/*adverse effects, Lung/*diagnostic imaging, Male, Middle Aged, Predictive Value of Tests, quantitative CT metrics, Retrospective Studies, Tidal Volume},
	pages = {1201--1212},
	annote = {Barbosa, Eduardo J Mortani JrLanclus, MaartenVos, WimVan Holsbeke, CedricDe Backer, WilliamDe Backer, JanLee, Jameseng2018/02/24Acad Radiol. 2018 Sep;25(9):1201-1212. doi: 10.1016/j.acra.2018.01.013. Epub 2018 Feb 19.},
	annote = {The following values have no corresponding Zotero field:auth-address: Perelman School of Medicine, University of Pennsylvania, Departments of Radiology and Medicine, 3400 Spruce Street, Philadelphia, PA 19104. Electronic address: Eduardo.Barbosa@uphs.upenn.edu. FLUIDDA nv, Kontich, Belgium. University Hospital Antwerp, Department of Respiratory Medicine, Edegem, Belgium. Perelman School of Medicine, University of Pennsylvania, Departments of Radiology and Medicine, 3400 Spruce Street, Philadelphia, PA 19104.edition: 20180219accession-num: 29472146remote-database-provider: NLM},
	file = {5_Barbosa et al. - 2018 - Machine Learning Algorithms Utilizing Quantitative CT Features May Predict Eventual Onset of Bronchi.pdf}
}

@article{brahmbhatt_lung_2022,
	title = {The lung allocation score and other available models lack predictive accuracy for post-lung transplant survival},
	volume = {41},
	issn = {1557-3117 (Electronic) 1053-2498 (Print) 1053-2498 (Linking)},
	doi = {10.1016/j.healun.2022.05.008},
	abstract = {BACKGROUND: Improved predictive models are needed in lung transplantation in the setting of a proposed allocation system that incorporates longer-term post-transplant survival in the United States. Allocation systems require accurate mortality predictions to justly allocate organs. METHODS: Utilizing the United Network for Organ Sharing database (2005-2017), we fit models to predict 1-year mortality based on the Lung Allocation Score (LAS), the Chan, et al, 2019 model, a novel "clinician" model (a priori clinician selection of pre-transplant covariates), and two machine learning models (Least Absolute Shrinkage and Selection Operator; LASSO and Random Forests) for predicting 1-year and 3-year post-transplant mortality. We compared predictive accuracy among models. We evaluated the calibration of models by comparing average predicted probability vs observed outcome per decile. We repeated analyses fit for 3-year mortality, disease category, including donor covariates, and LAS era. RESULTS: The area under the cure for all models was low, ranging from 0.55 to 0.62. All exhibited reasonable negative predictive values (0.87-0.90), but the positive predictive value for was poor (all {\textless}0.25). Evaluating LAS calibration found 1-year post-transplant estimates consistently overestimated risk of mortality, with greater differences in higher deciles. LASSO, Random Forests, and clinician models showed no improvement when evaluated by disease category or with the addition of donor covariates and performed worse for 3-year outcomes. CONCLUSIONS: The LAS overestimated patients' risk of post-transplant death, thus underestimating transplant benefit in the sickest candidates. Novel models based on pre-transplant recipient covariates failed to improve prediction. There should be wariness in post-transplant survival predictions from available models.},
	number = {8},
	journal = {J Heart Lung Transplant},
	author = {Brahmbhatt, J. M. and Hee Wai, T. and Goss, C. H. and Lease, E. D. and Merlo, C. A. and Kapnadak, S. G. and Ramos, K. J.},
	month = aug,
	year = {2022},
	keywords = {*Lung Transplantation, *Tissue and Organ Procurement, Humans, Lung, lung allocation score, lung transplant outcomes, lung transplantation, organ allocation, Patient Selection, predictive accuracy, Retrospective Studies, Survival Rate, United States/epidemiology, Waiting Lists},
	pages = {1063--1074},
	annote = {Brahmbhatt, Jay MHee Wai, TravisGoss, Christopher HLease, Erika DMerlo, Christian AKapnadak, Siddhartha GRamos, Kathleen JengK23 HL138154/HL/NHLBI NIH HHS/P30 DK089507/DK/NIDDK NIH HHS/Research Support, N.I.H., ExtramuralResearch Support, Non-U.S. Gov't2022/06/12J Heart Lung Transplant. 2022 Aug;41(8):1063-1074. doi: 10.1016/j.healun.2022.05.008. Epub 2022 May 20.},
