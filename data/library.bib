	keywords = {*Heart Transplantation/adverse effects, *Machine Learning, *Primary Graft Dysfunction/etiology/diagnosis, Algorithms, explainable artificial intelligence, Female, heart transplant, Humans, machine learning, primary graft dysfunction, Risk Factors, ROC Curve, Tissue Donors, Transplant Recipients},
	pages = {1101--1109},
	annote = {Ding, SiruiLiang, YafenChang, Chia-YuanBrown, CherylJiang, XiaoqianHu, XiaZou, Naeng1OT2OD032581-02-999/GF/NIH HHS/England2025/04/28J Am Med Inform Assoc. 2025 Jul 1;32(7):1101-1109. doi: 10.1093/jamia/ocaf066.},
	annote = {The following values have no corresponding Zotero field:auth-address: Department of Computer Science and Engineering, Texas A\&M University, College Station, TX 77840, United States. Department of Anesthesiology, University of Texas Health Center at Houston, Houston, TX 77030, United States. Department of Political Science and Public Administration, University of North Carolina at Charlotte, Charlotte, NC 28223, United States. McWilliams School of Biomedical Informatics, University of Texas Health Science Center at Houston, Houston, TX 77030, United States. Department of Computer Science, Rice University, Houston, TX 77005, United States. Department of Industrial Engineering, University of Houston, Houston, TX 77204, United States.accession-num: 40290063custom1: There is nothing to declare.remote-database-provider: NLM},
