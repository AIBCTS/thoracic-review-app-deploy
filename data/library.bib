	keywords = {*Databases, Factual, artificial organs/support devices: heart/ventricular assist devices, clinical research/practice, Female, Follow-Up Studies, gender, health services and outcomes research, Heart Failure/*mortality/surgery, Heart Transplantation/*mortality, heart transplantation/cardiology, Humans, Machine Learning, Male, Middle Aged, organ procurement and allocation, organ transplantation in general, patient survival, Prognosis, Registries/*statistics \& numerical data, Resource Allocation/methods, Risk Factors, Scientific Registry for Transplant Recipients (SRTR), Survival Rate, Time Factors, Tissue and Organ Procurement/*methods, Transplant Recipients/*statistics \& numerical data, Waiting Lists/*mortality, waitlist management},
