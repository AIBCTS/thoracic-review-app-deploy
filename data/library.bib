	doi = {10.1038/s41467-023-40468-7},
	file = {43_Sage et al. - 2023 - A machine-learning approach to human ex vivo lung perfusion predicts transplantation outcomes and pr.pdf},
	issn = {2041-1723 (Electronic) 2041-1723 (Linking)},
